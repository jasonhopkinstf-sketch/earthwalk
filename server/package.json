{
  "name": "earthwalk-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EarthWalk world server: generates world chunks from open map data and hosts meetup rooms",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "earcut": "^3.0.0",
    "pngjs": "^7.0.0",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
